# ReaxFF demo: bcc iron slab meeting oxygen gas (generic oxidation showcase).
# Force field: ffield.reax.Fe_O_C_H, distributed with LAMMPS
# (Aryanpour, van Duin & Kubicki, J. Phys. Chem. A 114, 6298 (2010)).
units real
atom_style charge
boundary p p f

lattice bcc 2.866
region box block 0 6 0 6 0 16
create_box 2 box

# iron slab on the floor of the box
region slab block INF INF INF INF 0 4.9
create_atoms 1 region slab

# oxygen gas above the surface
region gas block 0.5 5.5 0.5 5.5 7 14
create_atoms 2 random 60 4275 gas overlap 1.8 maxtry 100

mass 1 55.845
mass 2 15.999

pair_style reaxff NULL
pair_coeff * * ffield.reax.Fe_O_C_H Fe O
fix q all qeq/reaxff 1 0.0 10.0 1e-6 reaxff

# keep the bottom two layers anchored so the slab doesn't drift
region bottom block INF INF INF INF 0 1.4
group bottom region bottom
group mobile subtract all bottom
fix hold bottom setforce 0.0 0.0 0.0

velocity mobile create 600.0 4928459
fix 1 mobile nvt temp 600.0 600.0 25.0

timestep 0.25
thermo 100
dump d all xyz 100 fe_oxidation.xyz
dump_modify d element Fe O
run 1200
