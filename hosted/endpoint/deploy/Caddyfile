# MDEngine hosted endpoint — TLS terminator in front of the Python service.
# Caddy obtains and renews the Let's Encrypt certificate by itself; the DNS A record
# for the hostname must already point at this box before the first start.
api.forcefieldsilicon.com {
	encode zstd gzip
	# Deck tarballs go through PUT /blob/...; allow the contract's 2 GB cap.
	request_body {
		max_size 2GB
	}
	reverse_proxy 127.0.0.1:8080 {
		# Long PUT/GET of multi-hundred-MB tarballs on a slow link.
		transport http {
			response_header_timeout 30m
			read_timeout 30m
			write_timeout 30m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	log {
		output file /var/log/caddy/api.access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
